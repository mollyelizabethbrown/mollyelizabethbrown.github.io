# Copy to .env.local for local development. In production these are set as GitHub repository
# variables (see .github/workflows/deploy.yml). Nothing here is secret: the site is static and
# reads only the public, published Sanity dataset at build time.

# Public site URL (canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mollyelizabethbrown.github.io

# Leave empty to build from content/data/. Set once the Sanity project exists.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# For the Studio (`npx sanity dev` / `npx sanity deploy`) — same values as above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# "true" only once Dr. Brown approves the launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
