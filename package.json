{
  "name": "molly-brown-website",
  "version": "0.1.0",
  "private": true,
  "description": "Research website of Dr. Molly E. Brown — Earth observation, climate and food security. Static Next.js on GitHub Pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:site": "node scripts/check-site.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "verify:dois": "node content/scripts/verify-dois.mjs",
    "import:doi": "node content/scripts/import-doi.mjs",
    "content:from-issue": "node content/scripts/content-from-issue.mjs",
    "qa": "npm run check:content && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
